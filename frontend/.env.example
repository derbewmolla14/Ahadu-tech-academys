# Frontend API origin (the app adds exactly one /api prefix).
# Capacitor/Android builds must use the absolute HTTPS production backend URL.
VITE_API_BASE_URL=https://ahadu-tech-academys.onrender.com
# Backward-compatible alias, if used by an older deployment:
# VITE_API_URL=https://ahadu-tech-academys.onrender.com/api

# OTA manifest URL. Leave blank to use the deployed frontend's /version.json.
# If using a separate CDN, it must allow HTTPS CORS requests from the app origin.
VITE_UPDATE_MANIFEST_URL=
# Optional absolute OTA ZIP URL. Leave blank to publish /ota-bundle.zip beside version.json.
VITE_OTA_BUNDLE_URL=
# Direct native app distribution links. Android must point to the signed APK over HTTPS.
VITE_ANDROID_UPDATE_URL=
# Optional iOS App Store or official iOS release page.
VITE_IOS_UPDATE_URL=
# Set true only when native code, permissions, or plugins require a new binary.
VITE_NATIVE_UPDATE_REQUIRED=false

# Manual premium-resource payment instructions (public display values only)
VITE_PAYMENT_BANK_NAME=
VITE_PAYMENT_ACCOUNT_NAME=
VITE_PAYMENT_ACCOUNT_NUMBER=
VITE_TELEBIRR_ACCOUNT_NAME=
VITE_TELEBIRR_PHONE=
# Telegram username without @, e.g. AhaduTechAcademy
VITE_PAYMENT_TELEGRAM_USERNAME=
# Optional full Telegram bot/admin chat URL (takes precedence over username)
VITE_PAYMENT_TELEGRAM_URL=
