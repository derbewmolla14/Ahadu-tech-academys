# Production API origin. The frontend appends exactly one /api prefix.
VITE_API_BASE_URL=https://ahadu-tech-academys.onrender.com
# Native Capacitor builds keep their local WebView origin, so use the deployed
# production manifest URL explicitly for remote OTA checks.
VITE_UPDATE_MANIFEST_URL=https://ahadu-tech-academys.vercel.app/version.json
# Optional: leave blank to resolve /ota-bundle.zip beside version.json.
VITE_OTA_BUNDLE_URL=
# Set these in Vercel Project Settings -> Environment Variables for production.
VITE_ANDROID_UPDATE_URL=
VITE_IOS_UPDATE_URL=
VITE_NATIVE_UPDATE_REQUIRED=false
