NODE_ENV=development
PORT=5173
# mongodb+srv://<db_username>:<db_password>@cluster0.uxtp1an.mongodb.net/
MONGO_URI=mongodb://127.0.0.1:27017/ahadu_tech_academy
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173



SUPER_ADMIN_BOOTSTRAP_SECRET=replace-with-bootstrap-secret
SUPER_ADMIN_EMAIL=admin@example.com
# Password-reset email delivery (SMTP). Configure these on the backend host (Render).
# Example: Gmail app password, Brevo, SendGrid SMTP relay, or another SMTP provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="Ahadu Tech Academy <verified-sender@example.com>"
# Frontend SPA origin; reset links open /reset-password in the web app.
FRONTEND_URL=http://localhost:5173

# Telegram Bot API (create a bot with BotFather; never commit the real token).
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# Bot username without @, e.g. AhaduTechAcademyBot.
TELEGRAM_BOT_USERNAME=AhaduTechAcademyBot
CLOUDINARY_CLOUD_NAME=djo6kszkl
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=


# Only this registered account receives administrator privileges on the website and Telegram bot.
# Keep this value identical to the designated admin account's registered email.
SUPER_ADMIN_EMAIL=admin@example.com

# --- Render.com / production ---
# PORT is injected by Render ($PORT); local dev uses PORT=5002 matching Vite proxy.
# FRONTEND_URL = deployed SPA origin, e.g. https://ahadu-tech-academys.vercel.app (required in production).
# SERVER_PUBLIC_URL = https://your-service.onrender.com (avatars /uploads URLs in JSON).
# CLIENT_ORIGINS = comma-separated allowed browser origins if you restrict CORS.

# SMTP notes:
# - Use the exact SMTP host/port/credentials supplied by your email provider.
# - Port 465 normally uses SMTP_SECURE=true; port 587 normally uses false (STARTTLS).
# - The sender address must be verified/authorized by the provider.
# - Never commit real SMTP credentials. Set them as backend service environment variables.

# Telegram account linking uses authenticated Settings → Account & Profile → Link Telegram.
# The backend polls Telegram getUpdates; run only one backend instance per bot token and do not configure a webhook for this bot.
# Link challenges expire in 10 minutes. Password-reset OTPs expire in exactly 60 seconds and allow 5 attempts.
